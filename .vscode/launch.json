{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "SLAM算法调试 (gdb) 启动",
            "type": "cppdbg",
            "request": "launch",
            "program": "/home/u/code_workplace/cpp/bathymetric_slam/bin/bathy_slam_real",
            // "args": ["--simulation","no ", "--bathy_survey","/home/link/sim_data/Pipeline/pipeline.cereal","--config","../config.yaml"],
            // "args": ["--simulation","yes", "--bathy_survey","../sim_data/map_small/","--config","../config.yaml"],
            // "args": ["--simulation","yes","--bathy_survey","../sim_data/250826_sub_maps/NESP_noINS_shortTest/","--config","../config.yaml"],
            // "args": ["--simulation","yes", "--bathy_survey","../sim_data/250826_sub_maps/NESP_noINS/","--config","../config.yaml"],
            // "args": ["--simulation","yes", "--bathy_survey","../sim_data/250911_sub_maps/Comb_noINS/","--config","../config.yaml"],
            "args": ["--simulation","yes", "--bathy_survey","../sim_data/251111_sub_maps/NESP_noINS/","--config","../config.yaml"],
            // "args": ["--simulation","yes", "--bathy_survey","../sim_data/251115_sub_maps/NESP_noINS/","--config","../config.yaml"],
            // "args": ["--simulation","yes", "--bathy_survey","../sim_data/251115_sub_maps/NESP_noINS_shortest/","--config","../config.yaml"],

            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "为 gdb 启用整齐打印",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "将反汇编风格设置为 Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Build"
        },
        {
            "name": "Python：绘制 SLAM 结果",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/plot_results.py",
            "console": "integratedTerminal",
            "args": [
                "--initial_poses",
                "build/poses_original.txt",
                "--corrupted_poses",
                "build/poses_corrupted.txt",
                "--optimized_poses",
                "build/poses_optimized.txt",
                "--save_fig",
                "build/",
                "--dpi",
                "600"
            ],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Python：APT 分析 poses_optimized",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/plot_apt.py",
            "console": "integratedTerminal",
            "args": [
                "--estimated",
                "build/poses_optimized.txt",
                "--ground_truth",
                "build/poses_original.txt",
                "--verbose",
                "--prefix",
                "optimized",
                "--save_fig",
                "build/"
            ],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Python：ATE 分析 poses_optimized (SE3对齐)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/plot_ate.py",
            "console": "integratedTerminal",
            "args": [
                "--estimated",
                "build/poses_optimized.txt",
                "--ground_truth",
                "build/poses_original.txt",
                "--alignment_type",
                "se3",
                "--verbose",
                "--prefix",
                "optimized"
            ],
            "cwd": "${workspaceFolder}"
        }
    ]
}